DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sf_tech_debt"
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Signs login session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Encrypts stored Salesforce access/refresh tokens at rest. Generate with the same command above.
TOKEN_ENCRYPTION_KEY=""

# Salesforce Connected Apps — one per environment (each org has its own local
# Connected App record). Locally, these fill themselves in automatically the first
# time you click Connect (see connectedAppSetup.ts) — nothing to run by hand. In
# production (NODE_ENV=production), that automation is disabled (it needs a local
# browser + Salesforce CLI), so create the Connected App once via Salesforce Setup
# and set its Client ID/Secret here directly.
SF_CALLBACK_URL="http://localhost:4000/auth/salesforce/callback"
SF_SANDBOX_CLIENT_ID=""
SF_SANDBOX_CLIENT_SECRET=""
SF_PROD_CLIENT_ID=""
SF_PROD_CLIENT_SECRET=""

ANTHROPIC_API_KEY=""

# AI provider for "Explain with AI" — anthropic (default) | openai | gemini.
# Only set the API key for whichever provider you pick.
AI_PROVIDER="anthropic"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
