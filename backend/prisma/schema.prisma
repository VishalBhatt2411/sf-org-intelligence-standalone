generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String                 @id @default(uuid())
  name        String
  createdAt   DateTime               @default(now()) @map("created_at")
  users       User[]
  connections SalesforceConnection[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  name           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("users")
}

model SalesforceConnection {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  organization      Organization        @relation(fields: [organizationId], references: [id])
  instanceUrl       String              @map("instance_url")
  sfOrgId           String              @map("sf_org_id")
  username          String              @default("")
  accessToken       String              @map("access_token")
  refreshToken      String              @map("refresh_token")
  loginUrl          String              @default("https://login.salesforce.com") @map("login_url")
  scheduleFrequency String              @default("off") @map("schedule_frequency")
  nextScanAt        DateTime?           @map("next_scan_at")
  graphSettings     Json?               @map("graph_settings")
  createdAt         DateTime            @default(now()) @map("created_at")
  scans             Scan[]
  graphNodes        GraphNode[]
  graphEdges        GraphEdge[]
  healthFindings    OrgHealthFinding[]
  healthSnapshots   OrgHealthSnapshot[]
  healthRuns        OrgHealthRun[]

  @@map("salesforce_connections")
}

model Scan {
  id           String               @id @default(uuid())
  connectionId String               @map("connection_id")
  connection   SalesforceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status       String               @default("running")
  startedAt    DateTime             @default(now()) @map("started_at")
  finishedAt   DateTime?            @map("finished_at")

  results               ScanResult[]
  findings              Finding[]
  objects               SfObject[]
  apexClasses           ApexClass[]
  triggers              ApexTrigger[]
  flows                 Flow[]
  permissionSets        PermissionSet[]
  profiles              Profile[]
  lwcComponents         LwcComponent[]
  dependencies          ComponentDependency[]
  orgWideDefaults       OrgWideDefault[]
  sharingRules          SharingRule[]
  userRoles             UserRole[]
  emailTemplates        EmailTemplate[]
  visualforcePages      VisualforcePage[]
  visualforceComponents VisualforceComponent[]
  installedPackages     InstalledPackage[]
  workflowRules         WorkflowRule[]

  @@map("scans")
}

model ScanResult {
  id             String   @id @default(uuid())
  scanId         String   @map("scan_id")
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category       String
  itemCount      Int      @map("item_count")
  // Graph scan stages record how complete the stage was: complete | partial | degraded.
  coverage       String?
  coverageDetail String?  @map("coverage_detail")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("scan_results")
}

model Finding {
  id              String             @id @default(uuid())
  scanId          String             @map("scan_id")
  scan            Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category        String
  ruleKey         String             @map("rule_key")
  severity        String
  title           String
  detail          String
  componentType   String             @map("component_type")
  componentName   String             @map("component_name")
  status          String             @default("open")
  assignedTo      String?            @map("assigned_to")
  createdAt       DateTime           @default(now()) @map("created_at")
  recommendations AiRecommendation[]

  @@map("findings")
}

model SfObject {
  id         String    @id @default(uuid())
  scanId     String    @map("scan_id")
  scan       Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  apiName    String    @map("api_name")
  label      String
  fieldCount Int       @map("field_count")
  sfId       String?   @map("sf_id")
  fields     SfField[]

  @@map("objects")
}

model SfField {
  id          String   @id @default(uuid())
  objectId    String   @map("object_id")
  object      SfObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  apiName     String   @map("api_name")
  type        String
  referenceTo Json?    @map("reference_to")
  sfId        String?  @map("sf_id")

  @@map("fields")
}

// Real Salesforce dependency edges from Tooling API's MetadataComponentDependency —
// componentId/Name/Type is the referencer, refComponentId/Name/Type is what it references.
model ComponentDependency {
  id               String @id @default(uuid())
  scanId           String @map("scan_id")
  scan             Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  componentId      String @map("component_id")
  componentName    String @map("component_name")
  componentType    String @map("component_type")
  refComponentId   String @map("ref_component_id")
  refComponentName String @map("ref_component_name")
  refComponentType String @map("ref_component_type")

  @@map("component_dependencies")
}

model Flow {
  id          String  @id @default(uuid())
  scanId      String  @map("scan_id")
  scan        Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  apiName     String  @map("api_name")
  label       String
  status      String
  triggerType String? @map("trigger_type")
  objectName  String? @map("object_name")
  definition  Json?
  sfId        String? @map("sf_id")

  @@map("flows")
}

model ApexClass {
  id         String  @id @default(uuid())
  scanId     String  @map("scan_id")
  scan       Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name       String
  body       String
  lineCount  Int     @map("line_count")
  sfId       String? @map("sf_id")
  // Tooling ApexClass.ApiVersion; null for rows scanned before it was captured.
  apiVersion Float?  @map("api_version")

  @@map("apex_classes")
}

model ApexTrigger {
  id         String  @id @default(uuid())
  scanId     String  @map("scan_id")
  scan       Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name       String
  objectName String  @map("object_name")
  body       String
  sfId       String? @map("sf_id")

  @@map("triggers")
}

model PermissionSet {
  id       String  @id @default(uuid())
  scanId   String  @map("scan_id")
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name     String
  permJson Json    @map("perm_json")
  sfId     String? @map("sf_id")

  @@map("permission_sets")
}

model Profile {
  id       String  @id @default(uuid())
  scanId   String  @map("scan_id")
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name     String
  permJson Json    @map("perm_json")
  sfId     String? @map("sf_id")

  @@map("profiles")
}

model LwcComponent {
  id      String  @id @default(uuid())
  scanId  String  @map("scan_id")
  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  apiName String  @map("api_name")
  source  String
  sfId    String? @map("sf_id")

  @@map("lwc_components")
}

model OrgWideDefault {
  id                   String  @id @default(uuid())
  scanId               String  @map("scan_id")
  scan                 Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  apiName              String  @map("api_name")
  internalSharingModel String  @map("internal_sharing_model")
  externalSharingModel String? @map("external_sharing_model")

  @@map("org_wide_defaults")
}

model SharingRule {
  id          String @id @default(uuid())
  scanId      String @map("scan_id")
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name        String
  objectName  String @map("object_name")
  ruleType    String @map("rule_type")
  accessLevel String @map("access_level")

  @@map("sharing_rules")
}

model UserRole {
  id            String  @id @default(uuid())
  scanId        String  @map("scan_id")
  scan          Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name          String
  developerName String  @map("developer_name")
  parentRoleId  String? @map("parent_role_id")
  sfId          String? @map("sf_id")

  @@map("user_roles")
}

model WorkflowRule {
  id          String  @id @default(uuid())
  scanId      String  @map("scan_id")
  scan        Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name        String
  objectName  String  @map("object_name")
  active      Boolean @default(false)
  triggerType String? @map("trigger_type")
  sfId        String? @map("sf_id")

  @@map("workflow_rules")
}

model EmailTemplate {
  id            String  @id @default(uuid())
  scanId        String  @map("scan_id")
  scan          Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name          String
  developerName String  @map("developer_name")
  templateType  String  @map("template_type")
  isActive      Boolean @default(true) @map("is_active")
  sfId          String? @map("sf_id")

  @@map("email_templates")
}

model VisualforcePage {
  id     String  @id @default(uuid())
  scanId String  @map("scan_id")
  scan   Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name   String
  markup String
  sfId   String? @map("sf_id")

  @@map("visualforce_pages")
}

model VisualforceComponent {
  id     String  @id @default(uuid())
  scanId String  @map("scan_id")
  scan   Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name   String
  markup String
  sfId   String? @map("sf_id")

  @@map("visualforce_components")
}

model InstalledPackage {
  id              String  @id @default(uuid())
  scanId          String  @map("scan_id")
  scan            Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name            String
  namespacePrefix String  @map("namespace_prefix")
  versionName     String? @map("version_name")
  versionNumber   String? @map("version_number")

  @@map("installed_packages")
}

model AiRecommendation {
  id             String   @id @default(uuid())
  findingId      String   @map("finding_id")
  finding        Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  explanation    String
  recommendation String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("ai_recommendations")
}

// ---------------------------------------------------------------------------
// Org Intelligence graph. One live graph per connection (not per scan): rows are
// upserted by checksum on every scan and marked "stale" when a full snapshot of
// their type no longer contains them. first/lastSeenScanId are plain references
// (no FK) so deleting an old scan never deletes graph history.
// ---------------------------------------------------------------------------
model GraphNode {
  id              String               @id @default(uuid())
  connectionId    String               @map("connection_id")
  connection      SalesforceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  nodeKey         String               @map("node_key")
  typeKey         String               @map("type_key")
  label           String
  fqn             String
  namespace       String?
  parentKey       String?              @map("parent_key")
  attributes      Json
  checksum        String
  state           String               @default("active")
  firstSeenScanId String               @map("first_seen_scan_id")
  lastSeenScanId  String               @map("last_seen_scan_id")

  @@unique([connectionId, nodeKey])
  @@index([connectionId, typeKey])
  @@index([connectionId, parentKey])
  @@map("graph_nodes")
}

model GraphEdge {
  id              String               @id @default(uuid())
  connectionId    String               @map("connection_id")
  connection      SalesforceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  edgeKey         String               @map("edge_key")
  typeKey         String               @map("type_key")
  sourceNodeKey   String               @map("source_node_key")
  targetNodeKey   String               @map("target_node_key")
  confidence      String
  attributes      Json
  checksum        String
  state           String               @default("active")
  firstSeenScanId String               @map("first_seen_scan_id")
  lastSeenScanId  String               @map("last_seen_scan_id")

  @@unique([connectionId, edgeKey])
  @@index([connectionId, sourceNodeKey])
  @@index([connectionId, targetNodeKey])
  @@map("graph_edges")
}

// ---- Org Health -------------------------------------------------------------------------------

// One row per detected issue, identified by a fingerprint of section + rule + component so the same
// problem is the same row across scans. Rows are never deleted: a finding that stops being detected
// is auto-resolved, which keeps its triage history.
model OrgHealthFinding {
  id                   String                  @id @default(uuid())
  connectionId         String                  @map("connection_id")
  connection           SalesforceConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  fingerprint          String
  section              String
  ruleKey              String                  @map("rule_key")
  ruleVersion          Int                     @default(1) @map("rule_version")
  componentKey         String                  @map("component_key")
  componentType        String                  @map("component_type")
  componentLabel       String                  @map("component_label")
  title                String
  severity             String
  confidence           String
  score                Float
  status               String                  @default("open")
  evidence             String
  measured             String
  expected             String
  explanation          String
  risk                 String
  impact               String
  remediation          String
  validation           String
  contributors         Json
  owner                String?
  dueDate              DateTime?               @map("due_date")
  notes                String?
  compensatingControl  String?                 @map("compensating_control")
  riskAcceptanceExpiry DateTime?               @map("risk_acceptance_expiry")
  falsePositiveReason  String?                 @map("false_positive_reason")
  firstDetectedAt      DateTime                @default(now()) @map("first_detected_at")
  lastDetectedAt       DateTime                @default(now()) @map("last_detected_at")
  resolvedAt           DateTime?               @map("resolved_at")
  lastRunId            String?                 @map("last_run_id")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  events               OrgHealthFindingEvent[]

  @@unique([connectionId, fingerprint])
  @@index([connectionId, section, status])
  @@index([connectionId, componentKey])
  @@map("org_health_findings")
}

// Append-only audit of every field change on a finding (triage edits and automatic transitions).
model OrgHealthFindingEvent {
  id        String           @id @default(uuid())
  findingId String           @map("finding_id")
  finding   OrgHealthFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?          @map("old_value")
  newValue  String?          @map("new_value")
  changedBy String           @map("changed_by")
  changedAt DateTime         @default(now()) @map("changed_at")

  @@index([findingId, changedAt])
  @@map("org_health_finding_events")
}

// The computed result of one section at one point in time; the newest per section is what the section
// endpoints serve, and the series over time is the trend.
model OrgHealthSnapshot {
  id           String               @id @default(uuid())
  connectionId String               @map("connection_id")
  connection   SalesforceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  section      String
  score        Float?
  severity     String?
  result       Json
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([connectionId, section, createdAt])
  @@map("org_health_snapshots")
}

// A Data Health run (live sampling can take a while, so it runs in the background and is polled).
model OrgHealthRun {
  id           String               @id @default(uuid())
  connectionId String               @map("connection_id")
  connection   SalesforceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  section      String
  status       String               @default("running")
  message      String?
  startedAt    DateTime             @default(now()) @map("started_at")
  finishedAt   DateTime?            @map("finished_at")

  @@index([connectionId, section, startedAt])
  @@map("org_health_runs")
}
